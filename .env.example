# Copy this file to .env for local overrides (and load it yourself, e.g. with
# `python -m pip install python-dotenv` + a small loader, or export manually)
# or set these as Environment Variables in your Vercel project settings.

# A long, random secret. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=change-me-to-a-long-random-value

# Keep this OFF (0) in production.
DJANGO_DEBUG=0

# Comma-separated list of hostnames this app is allowed to serve.
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Comma-separated list of full origins (with scheme) allowed to POST here.
DJANGO_CSRF_TRUSTED_ORIGINS=https://your-project.vercel.app

# REQUIRED for production on Vercel: SQLite cannot be used there because the
# filesystem is read-only/ephemeral. Point this at a hosted Postgres
# instance (Vercel Postgres, Neon, Supabase, Railway, etc).
# Leave unset locally to keep using the bundled SQLite file.
DATABASE_URL=postgres://user:password@host:5432/dbname
